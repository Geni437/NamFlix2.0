APP_NAME=NamFlix
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://namflix.info/api

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=namflix_db
DB_USERNAME=namflix_user
DB_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Shared secret between Supabase Edge Functions and Laravel internal endpoints
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Frontend URL (used for Stripe redirect URLs)
FRONTEND_URL=https://namflix.info

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_ANNUAL_PRICE_ID=price_...

# Google Play IAP verification — service account JSON (single-line, escaped)
# Download from Google Cloud Console → IAM → Service Accounts
GOOGLE_PLAY_PACKAGE_NAME=com.namflix.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Apple IAP verification — App Store Connect shared secret
# Found in App Store Connect → In-App Purchases → App-Specific Shared Secret
APPLE_SHARED_SECRET=

CORS_ALLOWED_ORIGINS=https://namflix.info,https://www.namflix.info
